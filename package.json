{
	"name": "three-forma-styli-repo",
	"private": true,
	"scripts": {
		"build": "pnpm --filter three-forma-styli build",
		"test": "pnpm --filter three-forma-styli test",
		"typecheck": "pnpm --filter three-forma-styli typecheck",
		"format": "prettier --write .",
		"check": "prettier --check . && pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"typescript": "^5.8.2"
	},
	"packageManager": "pnpm@11.9.0"
}
