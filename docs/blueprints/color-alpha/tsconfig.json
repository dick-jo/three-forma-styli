{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"paths": {
			"@three-forma-styli/core": ["../../../packages/core/src/index.ts"],
			"@three-forma-styli/core/runtime": ["../../../packages/core/src/runtime/index.ts"]
		}
	},
	"include": ["*.ts", "baseline/*.ts", "groups/*.ts", "luminance/*.ts", "constraints/*.ts"]
}
