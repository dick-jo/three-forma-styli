{
	"name": "@three-forma-styli/cli",
	"version": "0.3.0",
	"type": "module",
	"sideEffects": false,
	"description": "CLI tool for generating design tokens from TypeScript definitions",
	"bin": {
		"tfs": "dist/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/api.d.ts",
			"import": "./dist/api.js"
		},
		"./project": {
			"types": "./dist/project.d.ts",
			"import": "./dist/project.js"
		},
		"./fonts": {
			"types": "./dist/fonts/prepare.d.ts",
			"import": "./dist/fonts/prepare.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "node ../../scripts/clean.mjs && tsc",
		"dev": "nodemon --watch 'src/**' --ext 'ts' --exec 'ts-node src/index.ts'",
		"start": "node dist/index.js",
		"prepack": "pnpm build",
		"test": "vitest run && pnpm test:types",
		"test:types": "tsc -p tsconfig.type-tests.json"
	},
	"keywords": [
		"design-tokens",
		"cli",
		"css-variables"
	],
	"author": "three",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dick-jo/three-forma-styli.git",
		"directory": "packages/cli"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@inquirer/input": "4.3.1",
		"@inquirer/select": "4.4.2",
		"@three-forma-styli/compiler": "workspace:^",
		"@three-forma-styli/core": "workspace:^",
		"@three-forma-styli/themes": "workspace:^",
		"chalk": "4.1.2",
		"commander": "^13.1.0",
		"esbuild": "^0.28.1",
		"fs-extra": "^11.3.0"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^22.13.9",
		"nodemon": "^3.1.14",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.2",
		"vitest": "^3.2.7"
	}
}
