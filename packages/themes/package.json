{
	"name": "@three-forma-styli/themes",
	"version": "0.3.0",
	"type": "module",
	"sideEffects": false,
	"description": "Typed starter and reference design-system source presets",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./default": {
			"types": "./dist/default/index.d.ts",
			"import": "./dist/default/index.js"
		},
		"./legacy": {
			"types": "./dist/legacy/index.d.ts",
			"import": "./dist/legacy/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "node ../../scripts/clean.mjs && tsc",
		"dev": "tsc --watch",
		"prepack": "pnpm build"
	},
	"keywords": [
		"design-tokens",
		"themes",
		"starter-themes"
	],
	"author": "three",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dick-jo/three-forma-styli.git",
		"directory": "packages/themes"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@three-forma-styli/core": "workspace:^"
	},
	"devDependencies": {
		"typescript": "^5.8.2"
	}
}
