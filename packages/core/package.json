{
	"name": "@three-forma-styli/core",
	"version": "0.2.0",
	"type": "module",
	"sideEffects": false,
	"description": "Core design token generation library - framework-agnostic, browser and Node.js compatible",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "node ../../scripts/clean.mjs && tsc",
		"dev": "tsc --watch",
		"prepack": "pnpm build",
		"test": "vitest run && pnpm test:types",
		"test:types": "tsc -p tsconfig.type-tests.json",
		"test:watch": "vitest"
	},
	"keywords": [
		"design-tokens",
		"css-variables",
		"theming",
		"oklch",
		"color"
	],
	"author": "three",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dick-jo/three-forma-styli.git",
		"directory": "packages/core"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"culori": "^4.0.1"
	},
	"devDependencies": {
		"@types/culori": "^2.1.1",
		"typescript": "^5.8.2",
		"vitest": "^3.2.7"
	}
}
