{
	"name": "three-forma-styli",
	"version": "0.5.0-dev",
	"private": true,
	"description": "A designer's opinionated shorthand for design systems: readable TypeScript in, CSS variables and exact types out.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js"
		}
	},
	"files": [
		"dist",
		"themes/standard"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json && tsc -p themes/tsconfig.json",
		"test": "vitest run",
		"knip": "knip"
	},
	"devDependencies": {
		"@types/fontkit": "2.0.9",
		"@types/node": "^24.19.0",
		"knip": "^5.88.1",
		"playwright": "1.61.1",
		"typescript": "^5.8.2",
		"vitest": "^3.2.7"
	},
	"license": "ISC",
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"esbuild": "^0.28.2",
		"fontkit": "2.0.4"
	},
	"bin": {
		"tfs": "./dist/cli.js"
	}
}
