{
	"name": "three-forma-styli",
	"version": "0.5.1",
	"description": "A designer's opinionated shorthand for design systems: readable TypeScript in, CSS variables and exact types out.",
	"keywords": [
		"design-system",
		"design-tokens",
		"css-variables",
		"oklch",
		"typography",
		"theming"
	],
	"license": "ISC",
	"author": "three",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dick-jo/three-forma-styli.git",
		"directory": "tfs"
	},
	"homepage": "https://github.com/dick-jo/three-forma-styli#readme",
	"bugs": {
		"url": "https://github.com/dick-jo/three-forma-styli/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"tfs": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js"
		}
	},
	"files": [
		"dist",
		"themes/standard",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json && tsc -p themes/tsconfig.json",
		"test": "vitest run",
		"knip": "knip",
		"prepack": "pnpm --dir .. build"
	},
	"dependencies": {
		"@types/fontkit": "2.0.9",
		"esbuild": "^0.28.2",
		"fontkit": "2.0.4"
	},
	"devDependencies": {
		"@types/node": "^24.19.0",
		"knip": "^5.88.1",
		"playwright": "1.61.1",
		"typescript": "^5.8.2",
		"vitest": "^3.2.7"
	}
}
